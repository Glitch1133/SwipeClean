<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13 and newer: photos -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Android 13 and newer: videos -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Android 13 and newer: audio -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Android 12 and older -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 9 and older: needed for permanent shared-storage deletion -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Deep shared-storage scanning for the SwipeClean file-manager prototype -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Needed for SwipeClean's installed-app cleanup category -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Optional special access for Last Used information -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Allows SwipeClean to launch Android's user-confirmed app uninstaller -->
    <uses-permission
        android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/swipeclean_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/swipeclean_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SwipeClean">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />

        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SwipeClean">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

    </application>

</manifest>
